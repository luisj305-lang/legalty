# Mercado Pago — sandbox credentials (never commit real values)
# MP_ACCESS_TOKEN: SECRET server-side token (TEST-... in sandbox / APP_USR-... in prod).
MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY: PUBLIC key, client-facing only (future MP Checkout SDK). NOT the
# access token — never use it server-side and never confuse the two.
MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET: shared HMAC secret for /api/webhook signature verification.
MP_WEBHOOK_SECRET=

# Optional override for the webhook notification URL. If unset, it is derived
# from the request host (https://<host>/api/webhook).
# MP_NOTIFICATION_URL=

# Contact form delivery endpoint (receives { name, email, message })
CONTACT_ENDPOINT=
